{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (console)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/XMLDoc2Markdown/bin/Debug/net10.0/xmldoc2md.exe",
            "args": [
                "${workspaceFolder}/../EternityWorks/src/Bindings/CSharp/EternityWorks/bin/Debug/EternityWorks.dll",
                "-o",
                "${workspaceFolder}/../eternity-works-docs/api-reference",
                "--structure",
                "tree",
                "--ignore-bindgen-imports",
                "--generate-sidebar",
                "assets/EternityWorksFull.png"
            ],
            "cwd": "${workspaceFolder}/src/XMLDoc2Markdown/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false
        }
    ]
}
